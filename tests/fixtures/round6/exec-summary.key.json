{
  "doc": "exec-summary.errors.txt",
  "clean": "exec-summary.clean.txt",
  "options": { "domain": "business" },
  "mustFlag": [
    { "id": "ES1", "rule": "paragraph-long", "match": "The review assesses", "occurrence": 1, "fix": null, "priority": "P0", "spanNote": "paragraph of 191 words" },
    { "id": "ES2", "rule": "unsupported-claim", "match": "Studies show that", "occurrence": 1, "fix": null, "priority": "P0" },
    { "id": "ES3", "rule": "acronym-undefined", "match": "MoP", "occurrence": 1, "fix": null, "priority": "P0" },
    { "id": "ES4", "rule": "unsupported-claim", "match": "massive", "occurrence": 1, "fix": null, "priority": "P0" },
    { "id": "ES5", "rule": "nominalisation", "match": "carry out an evaluation of", "occurrence": 1, "fix": "evaluate", "priority": "P0" },
    { "id": "ES6", "rule": "unsupported-claim", "match": "Undoubtedly,", "occurrence": 1, "fix": null, "priority": "P0" },
    { "id": "ES7", "rule": "verb-pattern", "match": "refused raising", "occurrence": 1, "fix": "refused to raise", "priority": "P0" },
    { "id": "ES8", "rule": "compound-subject", "match": "depends on the budget", "occurrence": 1, "fix": "depend", "priority": "P0", "spanNote": "underline 'depends' only" },
    { "id": "ES9", "rule": "pronoun-agreement", "match": "their progress report", "occurrence": 1, "fix": "its", "priority": "P0", "spanNote": "underline 'their' only" },
    { "id": "ES10", "rule": "acronym-redefined", "match": "demand-side management (DSM)", "occurrence": 2, "fix": "DSM", "priority": "P0" },
    { "id": "ES11", "rule": "paragraph-same-start", "match": "The state refused", "occurrence": 1, "fix": null, "priority": "P0", "spanNote": "3 consecutive sentences start 'The state'" },
    { "id": "ES12", "rule": "consistency-case", "match": "Net-Metering", "occurrence": 1, "fix": "net-metering", "priority": "P0", "spanNote": "1 vs 1 tie; lowercase wins because the lowercase form occurs mid-sentence" },
    { "id": "ES13", "rule": "paragraph-end", "match": "central law", "occurrence": 1, "fix": "law.", "priority": "P0", "spanNote": "insertion of '.'" }
  ],
  "mustNotFlag": [
    { "rule": "acronym-*", "match": "MW", "why": "unit" },
    { "rule": "*", "match": "1,200", "why": "neutral 4-digit grouping" },
    { "rule": "*", "match": "₹4,800 crore", "why": "neutral" },
    { "rule": "unsupported-claim", "match": "most of it generated from coal", "why": "'most' with a stated quantity nearby is not a claim of this kind" },
    { "rule": "title-term-unused", "match": "Goa Power Sector Review 2024", "why": "all title terms appear in the body" }
  ]
}
