{
  "doc": "methods.errors.txt",
  "clean": "methods.clean.txt",
  "options": { "domain": "academic" },
  "mustFlag": [
    { "id": "ME1", "rule": "acronym-before-definition", "match": "GED", "occurrence": 1, "fix": null, "priority": "P0" },
    { "id": "ME2", "rule": "keyword-unused", "match": "heat stress", "occurrence": 1, "fix": null, "priority": "P0" },
    { "id": "ME3", "rule": "number-separator", "match": "2450", "occurrence": 1, "fix": "2,450", "priority": "P0" },
    { "id": "ME4", "rule": "study-tense", "match": "We will match", "occurrence": 1, "fix": null, "priority": "P0" },
    { "id": "ME5", "rule": "verb-pattern", "match": "managed collecting", "occurrence": 1, "fix": "managed to collect", "priority": "P0" },
    { "id": "ME6", "rule": "compound-subject", "match": "was recorded", "occurrence": 1, "fix": "were", "priority": "P0", "spanNote": "underline 'was' only; the passive card may also exist" },
    { "id": "ME7", "rule": "acronym-undefined", "match": "ACs", "occurrence": 1, "fix": null, "priority": "P0" },
    { "id": "ME8", "rule": "consistency-hyphen", "match": "smart meter data", "occurrence": 1, "fix": "smart-meter data", "priority": "P0", "spanNote": "span may be 'smart meter', fix 'smart-meter'" },
    { "id": "ME9", "rule": "consistency-percent", "match": "5%", "occurrence": 1, "fix": null, "priority": "P0" },
    { "id": "ME10", "rule": "unsupported-claim", "match": "Clearly,", "occurrence": 1, "fix": null, "priority": "P0" },
    { "id": "ME11", "rule": "unsupported-claim", "match": "Several studies have shown", "occurrence": 1, "fix": null, "priority": "P0" },
    { "id": "ME12", "rule": "paragraph-same-start", "match": "We will match", "occurrence": 1, "fix": null, "priority": "P0", "spanNote": "4 consecutive sentences start with 'We'" }
  ],
  "mustNotFlag": [
    { "rule": "study-tense", "match": "We obtained", "why": "not in this version; in the clean version present (abstract) + past (methods) is conventional" },
    { "rule": "acronym-redefined", "match": "(GED)", "why": "only one definition in this version" },
    { "rule": "number-separator", "match": "2019", "why": "years are exempt" },
    { "rule": "number-separator", "match": "2023", "why": "years are exempt" },
    { "rule": "keyword-unused", "match": "smart meters", "why": "matched by 'smart-meter' (hyphen split + plural stem)" },
    { "rule": "keyword-unused", "match": "cooling demand", "why": "matched by 'demand for cooling' in one sentence" },
    { "rule": "keyword-unused", "match": "household survey", "why": "matched by 'survey of 412 households'" }
  ]
}
