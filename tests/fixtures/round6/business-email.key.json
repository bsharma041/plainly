{
  "doc": "business-email.errors.txt",
  "clean": "business-email.clean.txt",
  "options": {
    "domain": "business",
    "goals": {
      "formality": "formal"
    }
  },
  "mustFlag": [
    {
      "id": "BE1",
      "rule": "consistency-case",
      "match": "Substation Upgrade",
      "occurrence": 2,
      "fix": "substation upgrade",
      "priority": "P0",
      "spanNote": "occurrence 1 is in the Subject line, which is exempt"
    },
    {
      "id": "BE2",
      "rule": "agreement",
      "match": "Each of the transformers are",
      "occurrence": 1,
      "fix": "Each of the transformers is",
      "priority": "existing"
    },
    {
      "id": "BE3",
      "rule": "consistency-percent",
      "match": "6%",
      "occurrence": 1,
      "fix": null,
      "priority": "P0",
      "spanNote": "1 vs 1 tie between % and 'per cent': advice listing both"
    },
    {
      "id": "BE4",
      "rule": "acronym-undefined",
      "match": "BOQ",
      "occurrence": 1,
      "fix": null,
      "priority": "P0"
    },
    {
      "id": "BE5",
      "rule": "date-format",
      "match": "June 3",
      "occurrence": 1,
      "fix": "3 June",
      "priority": "P1"
    },
    {
      "id": "BE6",
      "rule": "date-format",
      "match": "20/06/2024",
      "occurrence": 1,
      "fix": null,
      "priority": "P1"
    },
    {
      "id": "BE7",
      "rule": "one-of-plural",
      "match": "reason",
      "occurrence": 1,
      "fix": "reasons",
      "priority": "existing"
    },
    {
      "id": "BE8",
      "rule": "paragraph-end",
      "match": "is attached",
      "occurrence": 1,
      "fix": "attached.",
      "priority": "P0",
      "spanNote": "fix may be an insertion of '.'"
    },
    {
      "id": "BE9",
      "rule": "register-in",
      "match": "Kindly",
      "occurrence": 1,
      "fix": "Please",
      "priority": "P1"
    },
    {
      "id": "BE10",
      "rule": "register-in",
      "match": "do the needful",
      "occurrence": 1,
      "fix": null,
      "priority": "P1"
    },
    {
      "id": "BE11",
      "rule": "preposition",
      "match": "discuss about",
      "occurrence": 1,
      "fix": "discuss",
      "priority": "existing"
    },
    {
      "id": "BE12",
      "rule": "intro-clause-comma",
      "match": "figures I am",
      "occurrence": 1,
      "fix": "figures, I am",
      "priority": "P1",
      "spanNote": "insertion of ',' after 'figures'"
    },
    {
      "id": "BE13",
      "rule": "register-in",
      "match": "prepone",
      "occurrence": 1,
      "fix": "bring forward",
      "priority": "P1"
    },
    {
      "id": "BE14",
      "rule": "wordy",
      "match": "revert back",
      "occurrence": 1,
      "fix": "reply",
      "priority": "P1",
      "spanNote": "Round-6 ruling Q1: the wordy card on 'revert back' offers 'reply' first when followed by with/to me/at the earliest (register sense), 'revert' second. BE15 merged here."
    },
    {
      "id": "BE16",
      "rule": "register-in",
      "match": "as per",
      "occurrence": 1,
      "fix": "according to",
      "priority": "P1"
    }
  ],
  "mustNotFlag": [
    {
      "rule": "title-case",
      "match": "Schedule",
      "why": "Subject: lines are exempt from heading capitalisation"
    },
    {
      "rule": "paragraph-end",
      "match": "Dear Ms Fernandes,",
      "why": "salutation"
    },
    {
      "rule": "paragraph-end",
      "match": "Regards,",
      "why": "sign-off"
    },
    {
      "rule": "paragraph-end",
      "match": "Konkan Grid Services",
      "why": "signature block"
    },
    {
      "rule": "*",
      "match": "₹4.2 crore",
      "why": "Indian currency units are not an error"
    }
  ]
}